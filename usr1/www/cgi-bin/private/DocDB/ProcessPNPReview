use CGI;
use DBI;
use XML::Twig;
use IPC::Open3;

open (DBG, ">>/tmp/dbg");
require "ProjectGlobals.pm";
require "CGIInclude.pm" or die $!;
require "XMLOutput.pm";
require "DocDBGlobals.pm";

$query = new CGI;

$dbh   = DBI->connect('DBI:mysql:'.$db_name.':'.$db_host,$db_rouser,$db_ropass);

%params = $query -> Vars;


my $DocRevID      = $params{docrevid} || 0;
my $DocumentID    = $params{docid} || 0;
my $Version       = $params{version} || 0;
my $DocumentAlias = $params{alias} || '';
my $ImportXML     = $params{importxml} || 0;



if ($ImportXML == 0) {
    $FullPNPReviewURL = $PNPReviewURL.$DocumentAlias;
}
else {
    my %XMLFields     = ("All" => $TRUE);

    #my $DocXMLOutput = XMLHeader();
    my $DocXMLOutput = ();

    NewXMLOutput ();
    
    my $DocumentXML = DocumentXMLOut( {-docid   => $DocumentID,
                                       -version => $Version,
                                       -display => \%XMLFields
                              } );
    
    $DocumentXML && $DocumentXML -> paste(last_child => $DocDBXML);
    $DocXMLOutput .= GetXMLOutput();
    
    my $ncat = open3(\*CHLD_IN, \*CHLD_OUT, \*CHLD_ERR, $NCatCommand) or die "open3() failed $!";

    print CHLD_IN $DocXMLOutput;
    
    print DBG  "NCAT: $NCatXMLCommand\n";

    system ($NCatXMLCommand);

    $FullPNPReviewURL = $PNPReviewURL.$DocumentAlias.'/import/';
}

$query = new CGI;

print $query -> redirect($FullPNPReviewURL);

close (DBG);


1;
